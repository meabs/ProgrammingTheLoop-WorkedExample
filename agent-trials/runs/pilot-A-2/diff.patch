+        raise HTTPException(status_code=404, detail="unknown product")
+    try:
+        stock = inventory.get_stock(sku)
+    except inventory.InventoryNotFound:
+        raise HTTPException(status_code=404, detail="unknown product")
+    except (inventory.InventoryUnavailable, inventory.InventoryContractError) as exc:
