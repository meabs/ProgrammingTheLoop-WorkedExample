+#!/usr/bin/env python3
+"""Minimal inventory service matching contracts/inventory.openapi.yaml (local dev only)."""
+import json
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+STOCK = {
+    "MUG-001": {"sku": "MUG-001", "on_hand": 12, "reserved": 2},
+    "TEE-042": {"sku": "TEE-042", "on_hand": 5, "reserved": 5},
+}
+
+
+class Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        if not self.path.startswith("/skus/"):
+            self.send_error(404)
+            return
+        sku = self.path.removeprefix("/skus/").split("/", 1)[0]
+        if sku not in STOCK:
+            self.send_error(404)
+            return
+        body = json.dumps(STOCK[sku]).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, format, *args):
+        return
+
+
+def main():
+    host = "127.0.0.1"
+    port = 8099
+    server = HTTPServer((host, port), Handler)
+    print(f"mock inventory listening on http://{host}:{port}", flush=True)
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
