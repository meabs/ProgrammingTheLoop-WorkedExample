+"""Inventory stock lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_BASE_URL", "http://127.0.0.1:8099").rstrip("/")
+_TIMEOUT = float(os.environ.get("INVENTORY_TIMEOUT_SECONDS", "5"))
+
+
+class InventoryNotFound(Exception):
+    """SKU is not known to inventory."""
+
+
+class InventoryUnavailable(Exception):
+    """Inventory could not be reached or returned an unexpected HTTP status."""
+
+
+class InventoryContractError(Exception):
+    """Response body did not match the pinned inventory contract."""
+
+
+def _parse_stock(payload: object, sku: str) -> dict:
+    if not isinstance(payload, dict):
+        raise InventoryContractError("response is not a JSON object")
+    for key in ("sku", "on_hand", "reserved"):
+        if key not in payload:
+            raise InventoryContractError(f"missing {key}")
+    if not isinstance(payload["sku"], str):
+        raise InventoryContractError("sku must be a string")
+    for key in ("on_hand", "reserved"):
+        if not isinstance(payload[key], int) or isinstance(payload[key], bool):
+            raise InventoryContractError(f"{key} must be an integer")
+        if payload[key] < 0:
+            raise InventoryContractError(f"{key} must be non-negative")
+    if payload["sku"] != sku:
+        raise InventoryContractError("sku mismatch")
+    return {
+        "sku": payload["sku"],
+        "on_hand": payload["on_hand"],
+        "reserved": payload["reserved"],
+    }
+
+
+def get_stock(sku: str) -> dict:
+    url = f"{BASE_URL}/skus/{sku}"
+    try:
+        response = httpx.get(url, timeout=_TIMEOUT)
+    except httpx.HTTPError as exc:
+        raise InventoryUnavailable(str(exc)) from exc
+    if response.status_code == 404:
+        raise InventoryNotFound()
+    if response.status_code != 200:
+        raise InventoryUnavailable(f"unexpected status {response.status_code}")
+    try:
+        payload = response.json()
+    except ValueError as exc:
+        raise InventoryContractError("invalid JSON") from exc
+    return _parse_stock(payload, sku)
