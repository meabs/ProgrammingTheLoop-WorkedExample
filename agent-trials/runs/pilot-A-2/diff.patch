@@ -0,0 +1,73 @@
+import logging
+
+from fastapi.testclient import TestClient
+
+from app.clients import inventory
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_known_sku_with_stock(monkeypatch):
+    monkeypatch.setattr(
+        inventory,
+        "get_stock",
+        lambda sku: {"sku": sku, "on_hand": 12, "reserved": 2},
+    )
+    r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "MUG-001", "available": 10, "in_stock": True}
+
+
+def test_known_sku_fully_reserved(monkeypatch):
+    monkeypatch.setattr(
+        inventory,
+        "get_stock",
+        lambda sku: {"sku": sku, "on_hand": 5, "reserved": 5},
+    )
+    r = client.get("/products/TEE-042/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "TEE-042", "available": 0, "in_stock": False}
+
+
+def test_unknown_catalogue_sku(monkeypatch):
+    def fail_if_called(_sku):
+        raise AssertionError("inventory should not be called for unknown catalogue SKU")
+
+    monkeypatch.setattr(inventory, "get_stock", fail_if_called)
+    assert client.get("/products/NOPE-000/availability").status_code == 404
+
+
+def test_unknown_inventory_sku(monkeypatch):
+    monkeypatch.setattr(
+        inventory,
+        "get_stock",
+        lambda _sku: (_ for _ in ()).throw(inventory.InventoryNotFound()),
+    )
+    assert client.get("/products/MUG-001/availability").status_code == 404
+
+
+def test_inventory_unreachable_logs_and_502(monkeypatch, caplog):
+    monkeypatch.setattr(
+        inventory,
+        "get_stock",
+        lambda _sku: (_ for _ in ()).throw(inventory.InventoryUnavailable("connection refused")),
+    )
+    with caplog.at_level(logging.ERROR):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any("inventory" in rec.message.lower() for rec in caplog.records)
+
+
+def test_inventory_invalid_payload_logs_and_502(monkeypatch, caplog):
+    monkeypatch.setattr(
+        inventory,
+        "get_stock",
+        lambda _sku: (_ for _ in ()).throw(inventory.InventoryContractError("missing on_hand")),
+    )
+    with caplog.at_level(logging.ERROR):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any("inventory" in rec.message.lower() for rec in caplog.records)
