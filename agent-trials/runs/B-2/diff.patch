@@ -11,3 +11,17 @@ def read_product(sku: str):
     if product is None:
         raise HTTPException(status_code=404, detail="unknown product")
     return product
+
+
+@app.get("/products/{sku}/availability")
+def read_availability(sku: str):
+    if catalogue.get_product(sku) is None:
+        raise HTTPException(status_code=404, detail="unknown product")
+    try:
+        stock = inventory.get_stock(sku)
+    except inventory.InventoryNotFound:
+        raise HTTPException(status_code=404, detail="unknown product")
+    except inventory.InventoryError:
+        raise HTTPException(status_code=502, detail="inventory unavailable")
+    available = stock["on_hand"] - stock["reserved"]
+    return {"sku": sku, "available": available, "in_stock": available > 0}
diff --git a/tests/test_availability.py b/tests/test_availability.py
new file mode 100644
index 0000000..ceeae73
--- /dev/null
+++ b/tests/test_availability.py
@@ -0,0 +1,49 @@
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+from app.clients import inventory
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_known_sku_with_stock():
+    with patch.object(
+        inventory,
+        "get_stock",
+        return_value={"sku": "MUG-001", "on_hand": 12, "reserved": 3},
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    assert r.json() == {"sku": "MUG-001", "available": 9, "in_stock": True}
+
+
+def test_known_sku_fully_reserved():
+    with patch.object(
+        inventory,
+        "get_stock",
+        return_value={"sku": "MUG-001", "on_hand": 10, "reserved": 10},
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    assert r.json() == {"sku": "MUG-001", "available": 0, "in_stock": False}
+
+
+def test_unknown_catalogue_sku():
+    r = client.get("/products/NOPE-000/availability")
+    assert r.status_code == 404
+
+
+def test_unknown_inventory_sku():
+    with patch.object(inventory, "get_stock", side_effect=inventory.InventoryNotFound()):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 404
+
+
+def test_inventory_unreachable_returns_502():
+    with patch.object(
+        inventory, "get_stock", side_effect=inventory.InventoryError("down")
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
diff --git a/tests/test_inventory_client.py b/tests/test_inventory_client.py
new file mode 100644
index 0000000..0f93251
--- /dev/null
+++ b/tests/test_inventory_client.py
@@ -0,0 +1,55 @@
+import logging
+from unittest.mock import patch
+
+import httpx
+
+from app.clients import inventory
+
+
+def test_get_stock_success():
+    response = httpx.Response(200, json={"sku": "MUG-001", "on_hand": 5, "reserved": 2})
+    with patch("app.clients.inventory.httpx.get", return_value=response):
+        assert inventory.get_stock("MUG-001") == {
+            "sku": "MUG-001",
+            "on_hand": 5,
+            "reserved": 2,
+        }
+
+
+def test_get_stock_not_found():
+    response = httpx.Response(404, json={"error": "unknown_sku"})
+    with patch("app.clients.inventory.httpx.get", return_value=response):
+        try:
+            inventory.get_stock("MUG-001")
+        except inventory.InventoryNotFound:
+            pass
+        else:
+            raise AssertionError("expected InventoryNotFound")
+
+
+def test_get_stock_bad_payload_logs_and_raises(caplog):
+    response = httpx.Response(200, json={"sku": "MUG-001", "on_hand": "nope"})
+    with patch("app.clients.inventory.httpx.get", return_value=response):
+        with caplog.at_level(logging.ERROR):
+            try:
+                inventory.get_stock("MUG-001")
+            except inventory.InventoryError:
+                pass
+            else:
+                raise AssertionError("expected InventoryError")
+    assert caplog.records
+
+
+def test_get_stock_network_error_logs_and_raises(caplog):
+    with patch(
+        "app.clients.inventory.httpx.get",
+        side_effect=httpx.ConnectError("connection refused"),
+    ):
+        with caplog.at_level(logging.ERROR):
+            try:
+                inventory.get_stock("MUG-001")
+            except inventory.InventoryError:
+                pass
+            else:
+                raise AssertionError("expected InventoryError")
+    assert caplog.records
