+"""Inventory stock lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_SERVICE_URL", "http://127.0.0.1:8090")
+
+
+class InventoryError(Exception):
+    """Inventory could not be reached or returned an invalid response."""
+
+
+class InventoryNotFound(Exception):
+    """SKU is not known to inventory."""
+
+
+def get_stock(sku: str) -> dict:
+    try:
+        with httpx.Client(base_url=BASE_URL, timeout=5.0) as client:
+            response = client.get(f"/skus/{sku}")
+    except httpx.RequestError:
+        logger.exception("inventory unreachable for sku=%s", sku)
+        raise InventoryError from None
+
+    if response.status_code == 404:
+        raise InventoryNotFound
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status %s for sku=%s",
+            response.status_code,
+            sku,
+        )
+        raise InventoryError
+
+    try:
+        payload = response.json()
+        on_hand = int(payload["on_hand"])
+        reserved = int(payload["reserved"])
+    except (KeyError, TypeError, ValueError):
+        logger.exception("inventory invalid response for sku=%s", sku)
+        raise InventoryError from None
+
+    return {"on_hand": on_hand, "reserved": reserved}
