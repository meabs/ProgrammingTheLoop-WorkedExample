@@ -0,0 +1,76 @@
+import logging
+from unittest.mock import MagicMock, patch
+
+import httpx
+from fastapi.testclient import TestClient
+
+from app.clients import inventory as inventory_client
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_known_sku_with_stock():
+    with patch.object(
+        inventory_client,
+        "get_stock",
+        return_value={"on_hand": 10, "reserved": 3},
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "MUG-001", "available": 7, "in_stock": True}
+
+
+def test_known_sku_fully_reserved():
+    with patch.object(
+        inventory_client,
+        "get_stock",
+        return_value={"on_hand": 5, "reserved": 5},
+    ):
+        r = client.get("/products/TEE-042/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "TEE-042", "available": 0, "in_stock": False}
+
+
+def test_unknown_catalogue_sku():
+    r = client.get("/products/NOPE-000/availability")
+    assert r.status_code == 404
+
+
+def test_unknown_inventory_sku():
+    with patch.object(
+        inventory_client,
+        "get_stock",
+        side_effect=inventory_client.InventoryNotFound(),
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 404
+
+
+def test_inventory_unreachable_returns_502_and_logs(caplog):
+    mock_client = MagicMock()
+    mock_client.__enter__.return_value = mock_client
+    mock_client.get.side_effect = httpx.RequestError("connection refused")
+
+    with caplog.at_level(logging.ERROR):
+        with patch("app.clients.inventory.httpx.Client", return_value=mock_client):
+            r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any("inventory" in rec.message.lower() for rec in caplog.records)
+
+
+def test_inventory_invalid_contract_returns_502_and_logs(caplog):
+    mock_client = MagicMock()
+    mock_client.__enter__.return_value = mock_client
+    bad = MagicMock()
+    bad.status_code = 200
+    bad.json.return_value = {"sku": "MUG-001"}
+    mock_client.get.return_value = bad
+
+    with caplog.at_level(logging.ERROR):
+        with patch("app.clients.inventory.httpx.Client", return_value=mock_client):
+            r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert caplog.records
