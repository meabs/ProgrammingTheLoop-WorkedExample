+    get:
+      summary: Stock levels for a SKU
+      parameters:
+        - name: sku
+          in: path
+          required: true
+          schema:
+            type: string
+      responses:
+        "200":
+          description: Stock found
+          content:
+            application/json:
+              schema:
+                type: object
+                required: [sku, on_hand, reserved]
+                properties:
+                  sku:
+                    type: string
+                  on_hand:
+                    type: integer
+                    minimum: 0
+                  reserved:
+                    type: integer
+                    minimum: 0
+        "404":
+          description: Unknown SKU
