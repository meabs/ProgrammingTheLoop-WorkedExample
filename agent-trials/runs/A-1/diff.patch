+"""Inventory stock lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_URL", "http://127.0.0.1:8001").rstrip("/")
+
+
+class InventoryNotFound(Exception):
+    """SKU is not known to inventory."""
+
+
+class InventoryError(Exception):
+    """Inventory could not return a valid stock response."""
+
+
+def get_stock(sku: str) -> dict:
+    url = f"{BASE_URL}/stock/{sku}"
+    try:
+        response = httpx.get(url, timeout=5.0)
+    except httpx.RequestError:
+        logger.exception("inventory unreachable for sku=%s", sku)
+        raise InventoryError("inventory unreachable") from None
+
+    if response.status_code == 404:
+        raise InventoryNotFound()
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status=%s sku=%s body=%s",
+            response.status_code,
+            sku,
+            response.text,
+        )
+        raise InventoryError(f"unexpected status {response.status_code}")
+
+    try:
+        payload = response.json()
+        on_hand = int(payload["on_hand"])
+        reserved = int(payload["reserved"])
+        sku_value = str(payload.get("sku", sku))
+    except (KeyError, TypeError, ValueError):
+        logger.exception("inventory invalid response for sku=%s", sku)
+        raise InventoryError("invalid response") from None
+
+    return {"sku": sku_value, "on_hand": on_hand, "reserved": reserved}
