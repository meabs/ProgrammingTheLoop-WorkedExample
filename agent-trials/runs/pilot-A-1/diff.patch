+"""Inventory lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+INVENTORY_BASE_URL = os.environ.get("INVENTORY_BASE_URL", "http://127.0.0.1:8091")
+
+
+class InventoryNotFound(Exception):
+    pass
+
+
+class InventoryUpstreamError(Exception):
+    pass
+
+
+def fetch_stock(sku: str) -> dict:
+    url = f"{INVENTORY_BASE_URL.rstrip('/')}/skus/{sku}"
+    try:
+        response = httpx.get(url, timeout=5.0)
+    except httpx.HTTPError as exc:
+        logger.error("inventory request failed for %s: %s", sku, exc)
+        raise InventoryUpstreamError(str(exc)) from exc
+
+    if response.status_code == 404:
+        raise InventoryNotFound(sku)
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status for %s: %s %s",
+            sku,
+            response.status_code,
+            response.text,
+        )
+        raise InventoryUpstreamError(f"status {response.status_code}")
+
+    try:
+        payload = response.json()
+        on_hand = payload["on_hand"]
+        reserved = payload["reserved"]
+        returned_sku = payload["sku"]
+    except (TypeError, KeyError, ValueError) as exc:
+        logger.error("inventory invalid payload for %s: %s", sku, exc)
+        raise InventoryUpstreamError("invalid payload") from exc
+
+    if not isinstance(on_hand, int) or not isinstance(reserved, int):
+        logger.error("inventory non-integer quantities for %s", sku)
+        raise InventoryUpstreamError("invalid quantity types")
+    if on_hand < 0 or reserved < 0 or reserved > on_hand:
+        logger.error("inventory inconsistent quantities for %s", sku)
+        raise InventoryUpstreamError("inconsistent quantities")
+
+    return {"sku": returned_sku, "on_hand": on_hand, "reserved": reserved}
