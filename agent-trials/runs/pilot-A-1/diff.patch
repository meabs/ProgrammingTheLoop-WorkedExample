@@ -0,0 +1,37 @@
+openapi: 3.0.3
+info:
+  title: inventory-service
+  version: 1.0.0
+paths:
+  /skus/{sku}:
+    get:
+      operationId: getSkuStock
+      parameters:
+        - name: sku
+          in: path
+          required: true
+          schema:
+            type: string
+      responses:
+        "200":
+          description: Stock for SKU
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/SkuStock"
+        "404":
+          description: Unknown SKU
+components:
+  schemas:
+    SkuStock:
+      type: object
+      required: [sku, on_hand, reserved]
+      properties:
+        sku:
+          type: string
+        on_hand:
+          type: integer
+          minimum: 0
+        reserved:
+          type: integer
+          minimum: 0
diff --git a/tests/test_availability.py b/tests/test_availability.py
new file mode 100644
index 0000000..945fccd
--- /dev/null
+++ b/tests/test_availability.py
@@ -0,0 +1,70 @@
+import logging
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_known_sku_with_stock():
+    with patch(
+        "app.main.fetch_stock",
+        return_value={"sku": "MUG-001", "on_hand": 10, "reserved": 3},
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "MUG-001", "available": 7, "in_stock": True}
+
+
+def test_known_sku_fully_reserved():
+    with patch(
+        "app.main.fetch_stock",
+        return_value={"sku": "TEE-042", "on_hand": 5, "reserved": 5},
+    ):
+        r = client.get("/products/TEE-042/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "TEE-042", "available": 0, "in_stock": False}
+
+
+def test_unknown_to_catalogue():
+    r = client.get("/products/NOPE-000/availability")
+    assert r.status_code == 404
+
+
+def test_unknown_to_inventory():
+    from app.clients.inventory import InventoryNotFound
+
+    with patch(
+        "app.main.fetch_stock",
+        side_effect=InventoryNotFound("TEE-042"),
+    ):
+        r = client.get("/products/TEE-042/availability")
+    assert r.status_code == 404
+
+
+def test_inventory_unreachable_logs_and_502():
+    import httpx
+
+    with patch(
+        "app.clients.inventory.httpx.get",
+        side_effect=httpx.ConnectError("connection refused"),
+    ):
+        with patch.object(logging.getLogger("app.clients.inventory"), "error") as log:
+            r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert log.called
+
+
+def test_inventory_invalid_payload_502():
+    from app.clients.inventory import InventoryUpstreamError
+
+    with patch(
+        "app.main.fetch_stock",
+        side_effect=InventoryUpstreamError("missing on_hand"),
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
