+openapi: 3.0.3
+info:
+  title: inventory-service
+  version: 1.0.0
+servers:
+  - url: http://127.0.0.1:8081
+paths:
+  /v1/stock/{sku}:
+    get:
+      summary: Stock level for a SKU
+      parameters:
+        - in: path
+          name: sku
+          required: true
+          schema:
+            type: string
+      responses:
+        "200":
+          description: Stock found
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/StockLevel"
+        "404":
+          description: Unknown SKU
+components:
+  schemas:
+    StockLevel:
+      type: object
+      required:
+        - sku
+        - on_hand
+        - reserved
+      properties:
+        sku:
+          type: string
+        on_hand:
+          type: integer
+          minimum: 0
+        reserved:
+          type: integer
+          minimum: 0
