+"""Inventory lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_BASE_URL", "http://127.0.0.1:8081")
+
+
+class InventoryError(Exception):
+    """Inventory service unreachable or returned an unexpected response."""
+
+
+class InventoryNotFound(Exception):
+    """SKU is unknown to inventory."""
+
+
+def get_stock(sku: str) -> dict:
+    url = f"{BASE_URL}/v1/stock/{sku}"
+    try:
+        response = httpx.get(url, timeout=5.0)
+    except httpx.HTTPError:
+        logger.exception("inventory request failed sku=%s url=%s", sku, url)
+        raise InventoryError from None
+
+    if response.status_code == 404:
+        raise InventoryNotFound
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status sku=%s status=%s body=%s",
+            sku,
+            response.status_code,
+            response.text,
+        )
+        raise InventoryError
+
+    try:
+        payload = response.json()
+        on_hand = int(payload["on_hand"])
+        reserved = int(payload["reserved"])
+    except (KeyError, TypeError, ValueError):
+        logger.exception("inventory invalid response sku=%s body=%s", sku, response.text)
+        raise InventoryError from None
+
+    return {"sku": sku, "on_hand": on_hand, "reserved": reserved}
