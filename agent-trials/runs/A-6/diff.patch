--- /dev/null
+++ b/scripts/mock_inventory.py
@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+"""Minimal inventory service for local manual checks (matches contracts/inventory.openapi.yaml)."""
+from fastapi import FastAPI, HTTPException
+
+app = FastAPI(title="inventory-service-mock")
+
+STOCK = {
+    "MUG-001": {"sku": "MUG-001", "on_hand": 12, "reserved": 2},
+    "TEE-042": {"sku": "TEE-042", "on_hand": 0, "reserved": 0},
+}
+
+
+@app.get("/v1/stock/{sku}")
+def read_stock(sku: str):
+    row = STOCK.get(sku)
+    if row is None:
+        raise HTTPException(status_code=404, detail="unknown sku")
+    return row
diff --git a/tests/test_availability.py b/tests/test_availability.py
new file mode 100644
index 0000000..8f0bc94
--- /dev/null
+++ b/tests/test_availability.py
@@ -0,0 +1,67 @@
+import logging
+from unittest.mock import MagicMock, patch
+
+import httpx
+from fastapi.testclient import TestClient
+
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_known_sku_with_stock():
+    with patch(
+        "app.clients.inventory.get_stock",
+        return_value={"sku": "MUG-001", "on_hand": 10, "reserved": 3},
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "MUG-001", "available": 7, "in_stock": True}
+
+
+def test_known_sku_fully_reserved():
+    with patch(
+        "app.clients.inventory.get_stock",
+        return_value={"sku": "TEE-042", "on_hand": 5, "reserved": 5},
+    ):
+        r = client.get("/products/TEE-042/availability")
+    assert r.status_code == 200
+    assert r.json() == {"sku": "TEE-042", "available": 0, "in_stock": False}
+
+
+def test_unknown_to_catalogue():
+    r = client.get("/products/NOPE-000/availability")
+    assert r.status_code == 404
+
+
+def test_unknown_to_inventory():
+    from app.clients import inventory
+
+    with patch("app.clients.inventory.get_stock", side_effect=inventory.InventoryNotFound):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 404
+
+
+def test_inventory_unreachable_logs_and_502(caplog):
+    caplog.set_level(logging.ERROR, logger="app.clients.inventory")
+    request = httpx.Request("GET", "http://127.0.0.1:8081/v1/stock/MUG-001")
+    with patch(
+        "httpx.get",
+        side_effect=httpx.ConnectError("connection refused", request=request),
+    ):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any(rec.name == "app.clients.inventory" for rec in caplog.records)
+
+
+def test_inventory_invalid_payload_logs_and_502(caplog):
+    caplog.set_level(logging.ERROR, logger="app.clients.inventory")
+    bad = MagicMock()
+    bad.status_code = 200
+    bad.text = '{"not": "stock"}'
+    bad.json.return_value = {"not": "stock"}
+    with patch("httpx.get", return_value=bad):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any(rec.name == "app.clients.inventory" for rec in caplog.records)
