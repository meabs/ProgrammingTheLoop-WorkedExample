@@ -0,0 +1,35 @@
+"""Minimal inventory service stub for local demos (contract-shaped responses)."""
+import json
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+STOCK = {
+    "MUG-001": {"sku": "MUG-001", "on_hand": 12, "reserved": 3},
+    "TEE-042": {"sku": "TEE-042", "on_hand": 5, "reserved": 5},
+}
+
+
+class Handler(BaseHTTPRequestHandler):
+    def log_message(self, format, *args):
+        return
+
+    def do_GET(self):
+        prefix = "/v2/stock/"
+        if not self.path.startswith(prefix):
+            self.send_error(404)
+            return
+        sku = self.path[len(prefix) :]
+        row = STOCK.get(sku)
+        if row is None:
+            body = json.dumps({"error": "unknown_sku"}).encode()
+            self.send_response(404)
+        else:
+            body = json.dumps(row).encode()
+            self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(body)
+
+
+if __name__ == "__main__":
+    port = int(__import__("os").environ.get("PORT", "9000"))
+    HTTPServer(("127.0.0.1", port), Handler).serve_forever()
diff --git a/tests/test_availability.py b/tests/test_availability.py
