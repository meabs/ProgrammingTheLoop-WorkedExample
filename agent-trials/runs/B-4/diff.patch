+++ b/tests/test_availability.py
@@ -0,0 +1,80 @@
+import logging
+
+import httpx
+import pytest
+from fastapi.testclient import TestClient
+
+from app.clients import inventory
+from app.main import app
+
+client = TestClient(app)
+
+
+@pytest.fixture(autouse=True)
+def reset_inventory_client():
+    inventory.set_http_client(None)
+    yield
+    inventory.set_http_client(None)
+
+
+def _mock_transport(handler):
+    inventory.set_http_client(
+        httpx.Client(transport=httpx.MockTransport(handler), base_url="http://inventory.test")
+    )
+
+
+def test_known_sku_with_stock():
+    def handler(request: httpx.Request) -> httpx.Response:
+        assert request.url.path == "/v2/stock/MUG-001"
+        return httpx.Response(200, json={"sku": "MUG-001", "on_hand": 12, "reserved": 3})
+
+    _mock_transport(handler)
+    r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    assert r.json() == {"sku": "MUG-001", "available": 9, "in_stock": True}
+
+
+def test_known_sku_fully_reserved():
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(200, json={"sku": "TEE-042", "on_hand": 5, "reserved": 5})
+
+    _mock_transport(handler)
+    r = client.get("/products/TEE-042/availability")
+    assert r.status_code == 200
+    assert r.json() == {"sku": "TEE-042", "available": 0, "in_stock": False}
+
+
+def test_unknown_catalogue_sku():
+    r = client.get("/products/NOPE-000/availability")
+    assert r.status_code == 404
+
+
+def test_unknown_inventory_sku():
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(404, json={"error": "unknown_sku"})
+
+    _mock_transport(handler)
+    r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 404
+
+
+def test_inventory_unreachable(caplog):
+    def handler(request: httpx.Request) -> httpx.Response:
+        raise httpx.ConnectError("connection refused")
+
+    _mock_transport(handler)
+    with caplog.at_level(logging.ERROR):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any("inventory" in rec.message.lower() for rec in caplog.records)
+
+
+def test_inventory_invalid_payload(caplog):
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(200, json={"sku": "MUG-001", "on_hand": "many"})
+
+    _mock_transport(handler)
+    with caplog.at_level(logging.ERROR):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any("inventory" in rec.message.lower() for rec in caplog.records)
