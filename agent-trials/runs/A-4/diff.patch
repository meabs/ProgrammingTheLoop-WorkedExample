@@ -0,0 +1,35 @@
+openapi: 3.0.3
+info:
+  title: inventory-service
+  version: 1.0.0
+servers:
+  - url: http://127.0.0.1:8001
+paths:
+  /skus/{sku}:
+    get:
+      summary: Stock levels for a SKU
+      parameters:
+        - name: sku
+          in: path
+          required: true
+          schema:
+            type: string
+      responses:
+        "200":
+          description: Known SKU
+          content:
+            application/json:
+              schema:
+                type: object
+                required: [sku, on_hand, reserved]
+                properties:
+                  sku:
+                    type: string
+                  on_hand:
+                    type: integer
+                    minimum: 0
+                  reserved:
+                    type: integer
+                    minimum: 0
+        "404":
+          description: Unknown SKU
