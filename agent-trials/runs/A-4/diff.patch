+"""Inventory stock levels via the inventory service HTTP API (see contracts/)."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_BASE_URL", "http://127.0.0.1:8001").rstrip("/")
+
+
+class InventoryNotFound(Exception):
+    pass
+
+
+class InventoryUpstreamError(Exception):
+    pass
+
+
+def get_levels(sku: str) -> tuple[int, int]:
+    """Return (on_hand, reserved) for a SKU."""
+    url = f"{BASE_URL}/skus/{sku}"
+    try:
+        with httpx.Client(timeout=5.0) as client:
+            response = client.get(url)
+    except httpx.RequestError as exc:
+        logger.error("inventory request failed for %s: %s", sku, exc)
+        raise InventoryUpstreamError(str(exc)) from exc
+
+    if response.status_code == 404:
+        raise InventoryNotFound(sku)
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status %s for %s: %s",
+            response.status_code,
+            sku,
+            response.text,
+        )
+        raise InventoryUpstreamError(f"unexpected status {response.status_code}")
+
+    try:
+        payload = response.json()
+        on_hand = payload["on_hand"]
+        reserved = payload["reserved"]
+        if type(on_hand) is not int or type(reserved) is not int:
+            raise TypeError("levels must be integers")
+        if on_hand < 0 or reserved < 0:
+            raise ValueError("levels must be non-negative")
+    except (KeyError, TypeError, ValueError) as exc:
+        logger.error("inventory invalid payload for %s: %s", sku, response.text)
+        raise InventoryUpstreamError("invalid payload") from exc
+
+    return on_hand, reserved
