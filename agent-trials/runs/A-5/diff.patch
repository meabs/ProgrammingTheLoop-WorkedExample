@@ -0,0 +1,17 @@
+"""Minimal inventory service stub matching contracts/inventory.openapi.yaml (local demos)."""
+from fastapi import FastAPI, HTTPException
+
+app = FastAPI(title="inventory-stub")
+
+STOCK = {
+    "MUG-001": {"sku": "MUG-001", "on_hand": 12, "reserved": 2},
+    "TEE-042": {"sku": "TEE-042", "on_hand": 5, "reserved": 5},
+}
+
+
+@app.get("/v1/stock/{sku}")
+def get_stock(sku: str):
+    row = STOCK.get(sku)
+    if row is None:
+        raise HTTPException(status_code=404, detail="unknown sku")
+    return row
