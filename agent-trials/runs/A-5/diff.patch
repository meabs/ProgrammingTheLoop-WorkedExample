+"""Inventory stock lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_BASE_URL", "http://localhost:8001").rstrip("/")
+
+
+class InventoryNotFoundError(Exception):
+    """SKU is not known to inventory."""
+
+
+class InventoryUnavailableError(Exception):
+    """Inventory could not be reached or returned data outside the contract."""
+
+
+def get_stock(sku: str) -> dict:
+    url = f"{BASE_URL}/v1/stock/{sku}"
+    try:
+        response = httpx.get(url, timeout=5.0)
+    except httpx.RequestError:
+        logger.exception("inventory request failed for sku=%s", sku)
+        raise InventoryUnavailableError("inventory unreachable") from None
+
+    if response.status_code == 404:
+        raise InventoryNotFoundError(sku)
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status %s for sku=%s body=%s",
+            response.status_code,
+            sku,
+            response.text,
+        )
+        raise InventoryUnavailableError(f"inventory status {response.status_code}")
+
+    try:
+        data = response.json()
+    except ValueError:
+        logger.exception("inventory returned non-json for sku=%s", sku)
+        raise InventoryUnavailableError("invalid json") from None
+
+    on_hand = data.get("on_hand")
+    reserved = data.get("reserved")
+    if not isinstance(on_hand, int) or not isinstance(reserved, int):
+        logger.error("inventory contract violation for sku=%s: %s", sku, data)
+        raise InventoryUnavailableError("invalid payload")
+
+    return {"sku": data.get("sku", sku), "on_hand": on_hand, "reserved": reserved}
