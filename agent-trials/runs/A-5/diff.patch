diff --git a/tests/test_availability.py b/tests/test_availability.py
new file mode 100644
index 0000000..aa4010e
--- /dev/null
+++ b/tests/test_availability.py
@@ -0,0 +1,59 @@
+import logging
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_known_sku_with_stock():
+    with patch("app.clients.inventory.get_stock", return_value={"sku": "MUG-001", "on_hand": 12, "reserved": 2}):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 200
+    body = r.json()
+    assert body == {"sku": "MUG-001", "available": 10, "in_stock": True}
+
+
+def test_known_sku_fully_reserved():
+    with patch("app.clients.inventory.get_stock", return_value={"sku": "TEE-042", "on_hand": 5, "reserved": 5}):
+        r = client.get("/products/TEE-042/availability")
+    assert r.status_code == 200
+    assert r.json() == {"sku": "TEE-042", "available": 0, "in_stock": False}
+
+
+def test_unknown_catalogue_sku():
+    r = client.get("/products/NOPE-000/availability")
+    assert r.status_code == 404
+
+
+def test_unknown_inventory_sku():
+    from app.clients.inventory import InventoryNotFoundError
+
+    with patch("app.clients.inventory.get_stock", side_effect=InventoryNotFoundError("MUG-001")):
+        r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 404
+
+
+def test_inventory_unreachable_returns_502_and_logs(caplog):
+    import httpx
+
+    with caplog.at_level(logging.ERROR):
+        with patch("app.clients.inventory.httpx.get", side_effect=httpx.ConnectError("connection refused")):
+            r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any("inventory" in rec.message.lower() for rec in caplog.records)
+
+
+def test_inventory_contract_violation_returns_502(caplog):
+    from unittest.mock import MagicMock
+
+    bad = MagicMock(status_code=200)
+    bad.json.return_value = {"sku": "MUG-001", "on_hand": "many", "reserved": 0}
+
+    with caplog.at_level(logging.ERROR):
+        with patch("app.clients.inventory.httpx.get", return_value=bad):
+            r = client.get("/products/MUG-001/availability")
+    assert r.status_code == 502
+    assert any("contract" in rec.message.lower() for rec in caplog.records)
