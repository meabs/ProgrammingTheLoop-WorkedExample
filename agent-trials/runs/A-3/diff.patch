new file mode 100644
index 0000000..51ae0d1
--- /dev/null
+++ b/contracts/inventory.openapi.yaml
@@ -0,0 +1,33 @@
+openapi: 3.0.3
+info:
+  title: inventory-service
+  version: 1.0.0
+paths:
+  /stock/{sku}:
+    get:
+      summary: Stock levels for a SKU
+      parameters:
+        - name: sku
+          in: path
+          required: true
+          schema:
+            type: string
+      responses:
+        "200":
+          description: Stock on hand and reserved units
+          content:
+            application/json:
+              schema:
+                type: object
+                required: [sku, on_hand, reserved]
+                properties:
+                  sku:
+                    type: string
+                  on_hand:
+                    type: integer
+                    minimum: 0
+                  reserved:
+                    type: integer
+                    minimum: 0
+        "404":
+          description: Unknown SKU
