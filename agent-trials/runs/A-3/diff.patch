@@ -0,0 +1,57 @@
+"""Inventory stock lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_BASE_URL", "http://127.0.0.1:8001")
+
+
+class InventoryError(Exception):
+    """Inventory service failed or returned data outside the contract."""
+
+
+class UnknownSku(InventoryError):
+    """SKU is not known to inventory."""
+
+
+def get_stock(sku: str) -> dict:
+    url = f"{BASE_URL}/stock/{sku}"
+    try:
+        response = httpx.get(url, timeout=5.0)
+    except httpx.RequestError:
+        logger.exception("inventory unreachable for sku=%s", sku)
+        raise InventoryError("inventory unreachable") from None
+
+    if response.status_code == 404:
+        raise UnknownSku()
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status %s for sku=%s body=%s",
+            response.status_code,
+            sku,
+            response.text,
+        )
+        raise InventoryError(f"unexpected status {response.status_code}")
+
+    try:
+        payload = response.json()
+        on_hand = payload["on_hand"]
+        reserved = payload["reserved"]
+        stock_sku = payload["sku"]
+    except (KeyError, TypeError, ValueError):
+        logger.exception("inventory response outside contract for sku=%s", sku)
+        raise InventoryError("response outside contract") from None
+
+    if not isinstance(on_hand, int) or not isinstance(reserved, int):
+        logger.error(
+            "inventory non-integer stock for sku=%s on_hand=%r reserved=%r",
+            sku,
+            on_hand,
+            reserved,
+        )
+        raise InventoryError("response outside contract")
+
+    return {"sku": stock_sku, "on_hand": on_hand, "reserved": reserved}
