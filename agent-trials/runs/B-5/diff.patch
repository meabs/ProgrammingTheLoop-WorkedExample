@@ -0,0 +1,56 @@
+"""Inventory stock lookups via the inventory service HTTP API."""
+import logging
+import os
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+BASE_URL = os.environ.get("INVENTORY_URL", "http://localhost:8081")
+
+
+class InventoryError(Exception):
+    """Inventory could not be reached or returned an invalid response."""
+
+
+class UnknownSkuError(Exception):
+    """SKU is not known to inventory."""
+
+
+def get_stock(sku: str) -> dict:
+    url = f"{BASE_URL.rstrip('/')}/v2/stock/{sku}"
+    try:
+        response = httpx.get(url, timeout=5.0)
+    except httpx.RequestError as exc:
+        logger.error("inventory unreachable for %s: %s", sku, exc)
+        raise InventoryError from exc
+
+    if response.status_code == 404:
+        raise UnknownSkuError()
+
+    if response.status_code != 200:
+        logger.error(
+            "inventory unexpected status %s for %s: %s",
+            response.status_code,
+            sku,
+            response.text,
+        )
+        raise InventoryError()
+
+    try:
+        data = response.json()
+        on_hand = data["on_hand"]
+        reserved = data["reserved"]
+    except (KeyError, TypeError, ValueError) as exc:
+        logger.error("inventory invalid JSON for %s: %s", sku, response.text)
+        raise InventoryError from exc
+
+    if not isinstance(on_hand, int) or not isinstance(reserved, int):
+        logger.error("inventory invalid field types for %s: %s", sku, data)
+        raise InventoryError()
+
+    if on_hand < 0 or reserved < 0:
+        logger.error("inventory negative stock for %s: %s", sku, data)
+        raise InventoryError()
+
+    return {"sku": data.get("sku", sku), "on_hand": on_hand, "reserved": reserved}
